[Unit]
Description=Repository-scoped GitHub Actions runner for FlashInfer wheels
After=network-online.target lil-flashinfer-rootless-docker.service
Wants=network-online.target
Requires=lil-flashinfer-rootless-docker.service

[Service]
Type=simple
User=github-flashinfer
Group=github-flashinfer
WorkingDirectory=/opt/actions-runner-flashinfer
Environment=HOME=/var/lib/github-flashinfer
Environment=DOCKER_HOST=unix:///run/lil-flashinfer-docker/docker.sock
ExecStart=/opt/actions-runner-flashinfer/run.sh
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=5min
TasksMax=4096
CPUQuota=200%
MemoryHigh=3G
MemoryMax=4G
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
